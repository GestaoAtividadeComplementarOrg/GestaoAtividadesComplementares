###############################################################################
# Obrigatório
###############################################################################

# Segredo usado para assinar os tokens JWT (HS256). Sem valor padrão: fora do
# perfil de testes a aplicação não inicia se esta variável não estiver definida.
# Precisa ser Base64 válido e ter no mínimo 256 bits. Gere o seu com:
#   openssl rand -base64 32
JWT_SECRET=

###############################################################################
# Perfil prod (PostgreSQL)
###############################################################################

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gestao_atividades_complementares
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Origens exatas permitidas no CORS, separadas por vírgula. Curingas não são
# aceitos porque a API responde com credenciais. No perfil dev o padrão é
# http://localhost:4200, definido em application.properties.
CORS_ALLOWED_ORIGINS=https://gestaoatividadescomplementares.onrender.com

# Validade do token em milissegundos (padrão: 86400000, equivalente a 24h).
JWT_EXPIRATION=86400000

# Porta HTTP exposta pela aplicação (padrão: 8080).
PORT=8080

###############################################################################
# Opcional (integrações de IA)
###############################################################################

GROQ_API_KEY=
HUGGINGFACE_API_KEY=
